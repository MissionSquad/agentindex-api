PORT=3100

# MongoDB
MONGO_USER=admin
MONGO_PASS=admin
MONGO_HOST=localhost:27017
MONGO_DBNAME=agentindex
MONGO_REPLICASET=

# Ethereum RPC
ETH_RPC_URL=http://10.1.200.113:8545
ETH_WS_URL=ws://10.1.200.113:8546
# Max time (ms) for a single JSON-RPC request before timing out (slow nodes / large blocks)
ETH_RPC_TIMEOUT_MS=120000

# Chain
CHAIN_ID=1
NETWORK_NAME=mainnet

# Scanner
SCANNER_START_BLOCK=24339870
SCANNER_ENABLED=true
CATCHUP_BATCH_SIZE=10
SCANNER_TX_CONCURRENCY=8
SCANNER_FAILURE_WINDOW_MS=300000
SCANNER_COOLDOWN_MS=60000
WS_RECONNECT_BASE_DELAY_MS=1000
WS_RECONNECT_MAX_DELAY_MS=30000
# Catch-up auto-restart backoff (when block sync crashes, it restarts from the
# last synced block instead of stopping)
SCANNER_RESTART_BASE_DELAY_MS=5000
SCANNER_RESTART_MAX_DELAY_MS=60000

# Metadata resolution
IPFS_GATEWAY_URLS=https://ipfs.io/ipfs/|https://cloudflare-ipfs.com/ipfs/|https://dweb.link/ipfs/
METADATA_HTTP_TIMEOUT_MS=10000
METADATA_IPFS_TIMEOUT_MS=30000
METADATA_FETCH_RETRIES=2
METADATA_RETRY_BASE_DELAY_MS=400
METADATA_RETRY_MAX_DELAY_MS=5000
METADATA_FETCH_CONCURRENCY=8
METADATA_IGNORED_URI_PREFIXES=https://ag0.xyz|https://agents.ultravioleta.xyz|https://example.com|https://chamba.ultravioletadao.xyz
METADATA_RE_RESOLVE_INTERVAL_MS=3600000
METADATA_RE_RESOLVE_MAX_AGE_MS=86400000
METADATA_RE_RESOLVE_BATCH_SIZE=50
METADATA_RETRY_INTERVAL_MS=900000
METADATA_RETRY_MAX_AGE_MS=900000
METADATA_RETRY_BATCH_SIZE=20

# CORS
ALLOWED_ORIGINS=http://localhost:3000|http://localhost:3100

# x402 (search endpoint monetization)
X402_ENABLED=false
X402_PORT=3101
X402_DEFAULT_NETWORK=eip155:8453
X402_DEFAULT_PAY_TO=
X402_LEASE_TOKEN_SECRET=
X402_FACILITATOR_URL=
X402_FACILITATOR_BEARER=
X402_SYNC_FACILITATOR_ON_START=true
X402_UPSTREAM_ORIGIN=http://127.0.0.1:3100
X402_ALLOW_INSECURE_HTTP_UPSTREAM=true
X402_ALLOW_PRIVATE_IP_UPSTREAMS=true

# ABI directory (for evmdecoder)
ABI_DIRECTORY=
